# ═══════════════════════════════════════════════════════════════════════════════
# Pathfinder — .gitignore
# ═══════════════════════════════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl
*.manifest
*.spec

# Virtual environments
venv/
.venv/
env/
ENV/

# ── Environment variables (NEVER commit secrets) ─────────────────────────────
.env
.env.*
!.env.example

# ── Node.js / Frontend ───────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
.cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Database ──────────────────────────────────────────────────────────────────
*.db
*.db-journal
*.sqlite3
*.sqlite3-journal

# ── Redis ─────────────────────────────────────────────────────────────────────
*.rdb
*.aof
dump.rdb

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# ── OS generated ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Testing / Coverage ───────────────────────────────────────────────────────
htmlcov/
.coverage
.coverage.*
.pytest_cache/
.tox/
.nox/
coverage.xml
nosetests.xml
*.cover
*.py.cover

# ── Type checking / Linting ──────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
.pytype/
.pyre/
.ruff_cache/

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Misc ──────────────────────────────────────────────────────────────────────
*.pid
tempCodeRunnerFile.py
explore_output.txt
