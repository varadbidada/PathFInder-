# Pathfinder — Environment Variables
# Copy this file to .env and fill in your values.

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# ── MongoDB Atlas (Persistent Storage) ───────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=pathfinder

# Alternative: Component-based MongoDB configuration (if MONGODB_URI not provided)
# MONGODB_USERNAME=your_username
# MONGODB_PASSWORD=your_password
# MONGODB_HOST=cluster.mongodb.net
# MONGODB_PORT=27017

# ── Groq (LLM) ───────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Reddit ────────────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=Pathfinder/1.0

# ── Twitter / X API v2 ────────────────────────────────────────────────────────
# Get your Bearer Token from: https://developer.twitter.com/en/portal/dashboard
# Free tier: 500k tweets/month (recent search only, last 7 days)
# Basic tier ($100/mo): Full archive search (all tweets ever)
# Academic/Pro tier: Full archive + higher rate limits
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_TARGET_TWEETS=200

# ── Serper (web search) ───────────────────────────────────────────────────────
SERPER_API_KEY=your_serper_api_key_here

# ── Redis (optional, for production caching) ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0
